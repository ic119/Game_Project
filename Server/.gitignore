# 이 .gitignore 파일은 C# 서버 프로젝트 루트(Server/)에 위치해야 합니다.
# 참고: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# --- 빌드 산출물 ---
[Bb]in/
[Oo]bj/
[Oo]ut/
[Bb]uild/
[Ll]og/
[Ll]ogs/

# --- 게시(publish) 산출물 ---
[Pp]ublish/
*.publish.xml
*.pubxml
*.pubxml.user

# --- Visual Studio / Rider 캐시 및 개인 설정 ---
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# --- NuGet ---
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# --- 테스트/커버리지 결과 ---
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# --- 크래시/덤프 ---
*.dmp
*.pdb

# --- 환경 변수 / 민감정보 (실서버 접속정보 등) ---
appsettings.*.local.json
appsettings.Development.json
.env
.env.*
*.pfx
*.key

# --- OS 관련 ---
.DS_Store
Thumbs.db
