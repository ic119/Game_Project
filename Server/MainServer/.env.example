# docker-compose용 환경변수 템플릿.
# 1) 이 파일을 .env로 복사한다:  cp .env.example .env
# 2) 아래 CHANGE_ME 값을 실제 비밀값으로 채운다.
# .env 자체는 Server/.gitignore에 의해 커밋되지 않는다 - 실제 비밀값을 여기(.env.example)에 채우지 말 것.

MYSQL_DATABASE=game_auth
MYSQL_USER=game_server
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# JWT 서명 키. 32자 이상의 랜덤 문자열 권장 (예: openssl rand -base64 48)
JWT_KEY=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_STRING

# MainServer(HTTP API) 앞단에서 Caddy가 Let's Encrypt HTTPS를 자동 발급/갱신할 도메인.
# 이 도메인이 배포할 VM의 공인 IP를 가리키도록 DNS A 레코드를 먼저 설정해야 발급에 성공한다.
# 선택 사항 - 비워두면 mysql/mainserver/gameserver는 정상 기동하고 caddy 컨테이너만 실패한다
# (그 경우 HTTPS 없이 mainserver에 ports를 직접 열어 평문 HTTP로 테스트 가능). 도메인이 생기면 채우고
# docker compose up -d --build만 다시 실행하면 된다.
DOMAIN=

# GameServer TCP(SslStream)에 쓸 실제 인증서(선택). 비워두면 자체 서명 인증서를 자동 생성해 쓰지만,
# 클라이언트 프로덕션 빌드는 이를 신뢰하지 않는다(GameServerCertificateProvider.cs 참고).
# 실서비스로 갈 때만 ./certs에 PFX 파일을 두고 아래 값을 채운다.
GAMESERVER_TLS_CERT_PATH=
GAMESERVER_TLS_CERT_PASSWORD=
