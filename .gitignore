# 이 파일은 저장소 루트(Client/Server 상위)에 위치하는 공통 .gitignore입니다.
# Unity(Client) 전용 규칙은 Client/.gitignore, C# 서버(Server) 전용 규칙은
# Server/.gitignore 에서 각각 관리합니다.

# --- OS 관련 ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- 공통 에디터/IDE ---
.idea/
*.swp
*.swo

# --- 환경 변수 / 민감정보 ---
.env
.env.local
.env.*.local
